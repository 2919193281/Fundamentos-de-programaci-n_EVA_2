    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="edad" type="Integer" array="False" size=""/>
            <output expression="&quot;&#191;Cuantos a&#241;os tienes?&quot;" newline="True"/>
            <input variable="edad"/>
            <if expression="edad &gt;= 18">
                <then>
                    <output expression="&quot;Puedes pasar &quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;No cumples con la edad para entrar&quot;" newline="True"/>
                </else>
            </if>
        </body>
